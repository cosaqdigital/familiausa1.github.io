---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_URL } from "../data/pilotContent";

const title = "Resultados Eleições Brasil 2026: 2º turno | FamiliaUSA1";
const description = "Acompanhe os resultados oficiais do 2º turno das eleições brasileiras de 2026, com dados do TSE, comparação de candidatos, apuração e governos estaduais.";
const canonical = `${SITE_URL}/eleicoes-brasil-2026.html`;
const apiBase = import.meta.env.PUBLIC_ELECTIONS_API_BASE_URL || "https://familiausa1-elections-api.vercel.app";
const englishUrl = `${SITE_URL}/brazil-election-2026.html`;
const alternates = [
  { hreflang: "pt-BR", href: canonical },
  { hreflang: "en-US", href: englishUrl },
  { hreflang: "x-default", href: canonical }
];
---

<BaseLayout title={title} description={description} canonical={canonical} alternates={alternates}>
  <section class="election-hero">
    <div class="container election-hero-grid">
      <div class="election-hero-copy">
        <span class="eyebrow hero-eyebrow">Eleições Brasil 2026 · 2º turno</span>
        <h1>Resultados oficiais em um painel simples de acompanhar</h1>
        <p>
          Presidente e governos estaduais com dados consultados na fonte oficial do Tribunal Superior Eleitoral (TSE).
          O painel atualiza automaticamente quando a apuração muda.
        </p>
        <div class="election-meta">
          <span>25 de outubro de 2026</span>
          <span>Fonte primária: TSE</span>
          <span>Atualização automática</span>
        </div>
      </div>

      <aside class="hero-summary-card" aria-label="Resumo da eleição">
        <span class="summary-label">Resumo rápido</span>
        <strong id="hero-status">Consultando dados oficiais...</strong>
        <p id="hero-summary">A página está conectando à API eleitoral do FamiliaUSA1.</p>
        <div class="hero-progress-track" aria-hidden="true">
          <span id="hero-progress-bar"></span>
        </div>
        <small id="hero-progress-text">Aguardando percentual de apuração</small>
      </aside>
    </div>
  </section>

  <section class="container election-dashboard">
    <div class="election-language-links"><a href="/eleicoes-2026.html">← Ver a central Eleições 2026 (Brasil e EUA)</a><a href="/brazil-election-2026.html" lang="en-US">View this election in English →</a></div>
    <div class="quick-facts-grid" aria-label="Informações rápidas">
      <article class="fact-card">
        <span>Eleição</span>
        <strong>2º turno</strong>
        <small>Presidente e governadores onde aplicável</small>
      </article>
      <article class="fact-card">
        <span>Pleito TSE</span>
        <strong>3221</strong>
        <small>25/10/2026</small>
      </article>
      <article class="fact-card">
        <span>Eleição federal</span>
        <strong>6258</strong>
        <small>Presidente</small>
      </article>
      <article class="fact-card">
        <span>Eleição estadual</span>
        <strong>6260</strong>
        <small>Governadores</small>
      </article>
    </div>

    <div class="election-status-card" id="election-status" data-api-base={apiBase}>
      <div class="status-heading">
        <span class="status-dot" aria-hidden="true"></span>
        <div>
          <strong id="status-title">Conectando à apuração oficial...</strong>
          <p id="status-message">Buscando a situação atual da eleição.</p>
        </div>
      </div>
      <small id="status-updated"></small>
    </div>

    <section class="dashboard-block" aria-labelledby="presidential-title">
      <div class="section-heading-row">
        <div>
          <span class="section-kicker">Presidência da República</span>
          <h2 id="presidential-title">Comparação nacional</h2>
        </div>
        <span class="counting-badge" id="presidential-counting">Aguardando dados</span>
      </div>

      <div id="presidential-feature" class="presidential-feature">
        <div class="waiting-card compact">
          <h3>Carregando candidatos</h3>
          <p>Os cards serão preenchidos assim que a API responder.</p>
        </div>
      </div>

      <div class="comparison-chart" id="comparison-chart" hidden>
        <div class="chart-header">
          <strong>Comparação dos votos válidos</strong>
          <span id="chart-caption"></span>
        </div>
        <div id="chart-bars" class="chart-bars"></div>
      </div>
    </section>

    <section class="dashboard-block metrics-block" aria-labelledby="numbers-title">
      <div class="section-heading-row">
        <div>
          <span class="section-kicker">Números da apuração</span>
          <h2 id="numbers-title">Visão geral</h2>
        </div>
      </div>
      <div id="election-metrics" class="metrics-grid">
        <div class="metric-card"><span>Seções apuradas</span><strong>—</strong></div>
        <div class="metric-card"><span>Eleitorado</span><strong>—</strong></div>
        <div class="metric-card"><span>Votos válidos</span><strong>—</strong></div>
        <div class="metric-card"><span>Abstenções</span><strong>—</strong></div>
      </div>
    </section>

    <section class="dashboard-block" id="state-results-section" aria-labelledby="states-title">
      <div class="section-heading-row">
        <div>
          <span class="section-kicker">Governadores</span>
          <h2 id="states-title">Resultados estaduais do 2º turno</h2>
        </div>
      </div>
      <div id="state-results" class="state-results">
        <div class="waiting-card compact">
          <h3>Aguardando dados estaduais</h3>
          <p>Os estados com 2º turno aparecerão aqui automaticamente.</p>
        </div>
      </div>
    </section>

    <section class="dashboard-block timeline-block" aria-labelledby="timeline-title">
      <div class="section-heading-row">
        <div>
          <span class="section-kicker">Linha do tempo</span>
          <h2 id="timeline-title">Como o painel acompanha a eleição</h2>
        </div>
      </div>
      <ol class="election-timeline">
        <li><strong>08:00</strong><span>Início da votação no horário de Brasília.</span></li>
        <li><strong>17:00</strong><span>Encerramento da votação e início da totalização nacional.</span></li>
        <li><strong>Apuração</strong><span>A API consulta os arquivos oficiais divulgados pelo TSE.</span></li>
        <li><strong>Final</strong><span>Quando o TSE sinaliza a totalização, o painel mantém o resultado final.</span></li>
      </ol>
    </section>

    <section class="official-source-card">
      <div>
        <span class="section-kicker">Fonte oficial</span>
        <h2>Dados do Tribunal Superior Eleitoral</h2>
        <p>
          O FamiliaUSA1 organiza os dados para facilitar a leitura, mas não substitui a divulgação oficial.
          Em caso de divergência, prevalece sempre a informação publicada pelo TSE.
        </p>
      </div>
      <a class="button primary" href="https://resultados.tse.jus.br/oficial/app/index.html#/eleicao/resultados" target="_blank" rel="noopener noreferrer">
        Ver resultados no TSE
      </a>
    </section>

    <section class="dashboard-block faq-block" aria-labelledby="faq-title">
      <div class="section-heading-row">
        <div>
          <span class="section-kicker">Perguntas rápidas</span>
          <h2 id="faq-title">Como ler os resultados</h2>
        </div>
      </div>
      <details class="faq-item">
        <summary>De onde vêm os números exibidos aqui?</summary>
        <p>Da infraestrutura oficial de divulgação de resultados do Tribunal Superior Eleitoral (TSE), por meio da API eleitoral preparada para o FamiliaUSA1.</p>
      </details>
      <details class="faq-item">
        <summary>O painel atualiza sozinho?</summary>
        <p>Sim. Durante votação e apuração, a página consulta novamente a API em intervalos curtos. Depois da finalização, reduz a frequência.</p>
      </details>
      <details class="faq-item">
        <summary>Por que o percentual pode mudar?</summary>
        <p>Durante a totalização, novas seções entram no cálculo. O percentual se estabiliza quando a apuração é finalizada.</p>
      </details>
    </section>
  </section>

  <script define:vars={{ apiBase }}>
    const endpoint = `${apiBase.replace(/\/$/, "")}/api/eleicoes/2026/segundo-turno`;
    const statusCard = document.getElementById("election-status");
    const statusTitle = document.getElementById("status-title");
    const statusMessage = document.getElementById("status-message");
    const statusUpdated = document.getElementById("status-updated");
    const heroStatus = document.getElementById("hero-status");
    const heroSummary = document.getElementById("hero-summary");
    const heroProgressBar = document.getElementById("hero-progress-bar");
    const heroProgressText = document.getElementById("hero-progress-text");
    const presidentialFeature = document.getElementById("presidential-feature");
    const presidentialCounting = document.getElementById("presidential-counting");
    const comparisonChart = document.getElementById("comparison-chart");
    const chartBars = document.getElementById("chart-bars");
    const chartCaption = document.getElementById("chart-caption");
    const metrics = document.getElementById("election-metrics");
    const stateResults = document.getElementById("state-results");
    const stateResultsSection = document.getElementById("state-results-section");

    const number = (value) => Number.isFinite(Number(value)) ? Number(value) : 0;
    const formatInt = (value) => number(value).toLocaleString("pt-BR");
    const formatPercentage = (value, fallback = 0) => {
      const source = value ?? fallback;
      const normalized = typeof source === "string"
        ? source.replace("%", "").trim().replace(",", ".")
        : source;
      const parsed = Number(normalized);
      const safe = Number.isFinite(parsed) ? parsed : number(fallback);
      return `${safe.toLocaleString("pt-BR", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      })}%`;
    };
    const escapeHtml = (value) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

    const OFFICIAL_CANDIDATE_PHOTOS = {
      "13": "https://images.weserv.nl/?url=www.tse.jus.br/imagens/imagens/lula/%40%40images/image-200-93d51d895f8ebc8900bf3e02c7052bef.png&w=360&h=420&fit=cover&output=webp",
      "22": "https://images.weserv.nl/?url=www.tse.jus.br/imagens/imagens/flavio-bolsonaro/%40%40images/image-200-7092d276831e3453f70c59d07d5c9ae7.png&w=360&h=420&fit=cover&output=webp"
    };

    function initials(name) {
      return String(name || "?")
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part[0]?.toUpperCase() || "")
        .join("");
    }

    function candidatePhoto(candidate) {
      const supplied = candidate.photoUrl || candidate.imageUrl || candidate.photo;
      if (supplied) return supplied;
      const ballotNumber = String(candidate.number || "").trim();
      return OFFICIAL_CANDIDATE_PHOTOS[ballotNumber] || "";
    }

    function candidateGroups(payload) {
      const groups = [];
      const seen = new Set();

      function walk(value) {
        if (!value || typeof value !== "object") return;
        if (Array.isArray(value)) {
          value.forEach(walk);
          return;
        }

        if (Array.isArray(value.candidates) && value.candidates.length) {
          const key = [value.scope, value.officeCode, value.officeName, value.electionId].filter(Boolean).join("|");
          if (!seen.has(key)) {
            seen.add(key);
            groups.push(value);
          }
        }

        Object.values(value).forEach(walk);
      }

      walk(payload);
      return groups;
    }

    function candidateCard(candidate, index) {
      const winner = Boolean(candidate.elected);
      const pct = formatPercentage(candidate.percentageDisplay, candidate.percentage);
      const name = candidate.ballotName || candidate.name;
      const photo = candidatePhoto(candidate);

      return `
        <article class="candidate-card ${winner ? "is-winner" : ""}">
          <div class="candidate-photo-wrap">
            ${photo
              ? `<img class="candidate-photo" src="${escapeHtml(photo)}" alt="Foto oficial de ${escapeHtml(name)} — TSE" loading="lazy" referrerpolicy="no-referrer" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />`
              : ""}
            <div class="candidate-avatar" ${photo ? "hidden" : ""}>${escapeHtml(initials(name))}</div>
            ${winner ? '<span class="winner-badge">Eleito</span>' : ""}
          </div>
          <div class="candidate-copy">
            <span class="candidate-position">#${index + 1}</span>
            <h3>${escapeHtml(name)}</h3>
            <p>${escapeHtml(candidate.party || "Partido não informado")}${candidate.number ? ` · nº ${escapeHtml(candidate.number)}` : ""}</p>
            <strong class="candidate-percentage">${escapeHtml(pct)}</strong>
            <span class="candidate-votes">${formatInt(candidate.votes)} votos</span>
          </div>
        </article>
      `;
    }

    function renderPresidential(group) {
      const candidates = [...group.candidates].sort((a, b) => number(b.votes) - number(a.votes));
      const counting = group.sections?.percentageDisplay
        ? formatPercentage(group.sections.percentageDisplay, group.sections?.percentage)
        : "";
      presidentialCounting.textContent = counting ? `${counting} apurado` : "Dados oficiais";
      presidentialFeature.innerHTML = candidates.slice(0, 2).map(candidateCard).join("");

      if (candidates.length) {
        comparisonChart.hidden = false;
        chartCaption.textContent = counting ? `${counting} das seções` : "";
        chartBars.innerHTML = candidates.slice(0, 4).map((candidate, index) => {
          const pct = number(candidate.percentage);
          const label = candidate.ballotName || candidate.name;
          const display = formatPercentage(candidate.percentageDisplay, pct);
          return `
            <div class="chart-row">
              <div class="chart-label"><strong>${escapeHtml(label)}</strong><span>${escapeHtml(display)}</span></div>
              <div class="chart-track"><span class="chart-fill chart-fill-${index + 1}" style="width:${Math.max(0, Math.min(100, pct))}%"></span></div>
            </div>
          `;
        }).join("");
      }

      const sectionPct = number(group.sections?.percentage);
      heroProgressBar.style.width = `${Math.max(0, Math.min(100, sectionPct))}%`;
      heroProgressText.textContent = group.sections?.percentageDisplay
        ? `${formatPercentage(group.sections.percentageDisplay, group.sections?.percentage)} das seções apuradas`
        : "Percentual de apuração ainda não informado";

      metrics.innerHTML = [
        ["Seções apuradas", group.sections?.counted ? `${formatInt(group.sections.counted)} / ${formatInt(group.sections.total)}` : "—"],
        ["Eleitorado", group.electorate?.total ? formatInt(group.electorate.total) : "—"],
        ["Votos válidos", group.votes?.valid ? formatInt(group.votes.valid) : "—"],
        ["Abstenções", group.electorate?.abstentions ? `${formatInt(group.electorate.abstentions)}${group.electorate.abstentionPercentageDisplay ? ` · ${escapeHtml(formatPercentage(group.electorate.abstentionPercentageDisplay, group.electorate.abstentionPercentage))}` : ""}` : "—"]
      ].map(([label, value]) => `<div class="metric-card"><span>${label}</span><strong>${value}</strong></div>`).join("");
    }

    function renderStateGroup(group) {
      const candidates = [...group.candidates].sort((a, b) => number(b.votes) - number(a.votes));
      const scope = group.scope ? group.scope.toUpperCase() : "UF";
      return `
        <article class="state-card">
          <header>
            <div><span class="state-code">${escapeHtml(scope)}</span><h3>${escapeHtml(group.officeName || "Governador")}</h3></div>
            <span>${escapeHtml(group.sections?.percentageDisplay || "")}</span>
          </header>
          <div class="state-candidates">
            ${candidates.slice(0, 2).map((candidate) => `
              <div>
                <strong>${escapeHtml(candidate.ballotName || candidate.name)}</strong>
                <span>${escapeHtml(candidate.party || "")}</span>
                <b>${escapeHtml(formatPercentage(candidate.percentageDisplay, candidate.percentage))}</b>
              </div>
            `).join("")}
          </div>
        </article>
      `;
    }

    function render(payload) {
      const timeline = payload?.timeline || {};
      const status = payload?.status || "temporarily-unavailable";
      const message = payload?.message || timeline.message || "Aguardando dados oficiais do TSE.";
      const title = timeline.title || (
        status === "counting" ? "Apuração em andamento" :
        status === "finalized" ? "Apuração finalizada" :
        status === "voting" ? "Votação em andamento" :
        status === "ready" ? "Dados oficiais disponíveis" :
        "Aguardando atualização oficial"
      );

      statusCard.dataset.status = status;
      statusTitle.textContent = title;
      statusMessage.textContent = message;
      statusUpdated.textContent = payload?.snapshotAt
        ? `Última consulta: ${new Date(payload.snapshotAt).toLocaleString("pt-BR")}`
        : "";

      heroStatus.textContent = title;
      heroSummary.textContent = message;

      const groups = candidateGroups(payload);
      const presidential = groups.find((group) =>
        String(group.officeCode).padStart(4, "0") === "0001" ||
        String(group.officeName || "").toLowerCase().includes("presidente")
      );
      const states = groups.filter((group) => group !== presidential);

      if (presidential) {
        renderPresidential(presidential);
      } else {
        presidentialFeature.innerHTML = `
          <div class="waiting-card compact">
            <h3>Resultado presidencial ainda não disponível</h3>
            <p>${escapeHtml(message)}</p>
          </div>
        `;
      }

      if (states.length) {
        stateResultsSection.hidden = false;
        stateResults.innerHTML = states.map(renderStateGroup).join("");
      } else if (status === "finalized") {
        stateResultsSection.hidden = true;
      } else {
        stateResultsSection.hidden = false;
        stateResults.innerHTML = `
          <div class="waiting-card compact">
            <h3>Resultados estaduais ainda não disponíveis</h3>
            <p>Quando a API retornar os estados do 2º turno, eles aparecerão aqui automaticamente.</p>
          </div>
        `;
      }

      const shouldPoll = timeline.shouldPoll ?? ["voting", "waiting-results", "counting"].includes(status);
      return shouldPoll;
    }

    async function refresh() {
      try {
        const response = await fetch(endpoint, {
          headers: { Accept: "application/json" },
          cache: "no-store"
        });

        if (!response.ok) throw new Error(`Resposta HTTP ${response.status}`);

        const payload = await response.json();
        const shouldPoll = render(payload);
        window.setTimeout(refresh, shouldPoll ? 15000 : 60000);
      } catch (error) {
        statusCard.dataset.status = "temporarily-unavailable";
        statusTitle.textContent = "Consulta temporariamente indisponível";
        statusMessage.textContent = "Não foi possível consultar a apuração agora. Tentaremos novamente automaticamente.";
        heroStatus.textContent = "Reconectando à fonte oficial";
        heroSummary.textContent = "A página tentará consultar a API novamente em alguns segundos.";
        window.setTimeout(refresh, 30000);
      }
    }

    refresh();
  </script>

  <style is:global>
    .election-hero {
      padding: clamp(96px, 11vw, 148px) 0 clamp(46px, 7vw, 80px);
      color: #fffaf1;
      background:
        radial-gradient(circle at 82% 22%, rgba(47, 92, 79, .5), transparent 27rem),
        radial-gradient(circle at 18% 90%, rgba(194, 138, 44, .25), transparent 22rem),
        linear-gradient(120deg, #0a1422 0%, #111d2e 54%, #263b59 100%);
    }

    .election-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(300px, .55fr);
      gap: clamp(26px, 5vw, 64px);
      align-items: center;
    }

    .election-hero-copy h1 {
      max-width: 880px;
      color: #fffaf1;
      margin: 14px 0 18px;
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 6vw, 5.4rem);
      line-height: .96;
      letter-spacing: -.06em;
    }

    .election-hero-copy > p {
      max-width: 790px;
      margin: 0;
      color: rgba(255, 250, 241, .84);
      font-size: clamp(1.04rem, 2vw, 1.3rem);
      line-height: 1.65;
    }

    .election-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 25px;
    }

    .election-meta span {
      border: 1px solid rgba(255,255,255,.16);
      border-radius: 999px;
      padding: 8px 11px;
      color: #ffe2a8;
      background: rgba(255,255,255,.07);
      font-size: .82rem;
      font-weight: 850;
    }

    .hero-summary-card {
      border: 1px solid rgba(255,255,255,.15);
      border-radius: 28px;
      padding: 24px;
      background: rgba(255,255,255,.08);
      box-shadow: 0 28px 75px rgba(0,0,0,.22);
      backdrop-filter: blur(12px);
    }

    .summary-label,
    .section-kicker {
      color: var(--terracotta);
      font-size: .76rem;
      font-weight: 950;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .hero-summary-card .summary-label { color: #ffe2a8; }
    .hero-summary-card strong { display:block; margin: 10px 0 8px; font-size:1.25rem; }
    .hero-summary-card p { margin:0; color:rgba(255,250,241,.76); line-height:1.55; }

    .hero-progress-track,
    .chart-track {
      overflow:hidden;
      border-radius:999px;
      background:rgba(255,255,255,.12);
    }

    .hero-progress-track { height:10px; margin-top:20px; }
    .hero-progress-track span { display:block; width:0; height:100%; border-radius:inherit; background:linear-gradient(90deg,#f6d37d,#c28a2c); transition:width .5s ease; }
    .hero-summary-card small { display:block; margin-top:8px; color:rgba(255,250,241,.62); }

    .election-dashboard { padding-top:34px; }
    .election-language-links { display:flex; justify-content:space-between; gap:18px; flex-wrap:wrap; margin:0 0 18px; font-weight:850; }
    .election-language-links a { color: var(--terracotta); text-decoration:none; }
    .election-language-links a:hover { text-decoration:underline; }

    .quick-facts-grid,
    .metrics-grid {
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:14px;
    }

    .fact-card,
    .metric-card,
    .election-status-card,
    .dashboard-block,
    .official-source-card,
    .candidate-card,
    .state-card,
    .waiting-card {
      border:1px solid var(--line);
      background:rgba(255,255,255,.92);
      box-shadow:var(--shadow-soft);
    }

    .fact-card,
    .metric-card { border-radius:20px; padding:18px; }
    .fact-card span,
    .metric-card span { display:block; color:var(--muted); font-size:.8rem; font-weight:850; text-transform:uppercase; letter-spacing:.08em; }
    .fact-card strong,
    .metric-card strong { display:block; margin:6px 0 3px; color:var(--navy); font-size:1.45rem; }
    .fact-card small { color:var(--ink-soft); }

    .election-status-card {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
      margin-top:18px;
      border-radius:22px;
      padding:20px 22px;
    }

    .status-heading { display:flex; gap:12px; align-items:flex-start; }
    .status-heading p { margin:5px 0 0; color:var(--ink-soft); }
    .election-status-card small { color:var(--muted); font-weight:750; }

    .status-dot {
      flex:0 0 auto;
      width:11px;
      height:11px;
      margin-top:6px;
      border-radius:999px;
      background:#c28a2c;
      box-shadow:0 0 0 6px rgba(194,138,44,.14);
    }

    .election-status-card[data-status="counting"] .status-dot,
    .election-status-card[data-status="voting"] .status-dot,
    .election-status-card[data-status="ready"] .status-dot,
