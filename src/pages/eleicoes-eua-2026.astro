---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_URL } from "../data/pilotContent";

const title = "Eleições EUA 2026 ao vivo: Midterms | FamiliaUSA1";
const description = "Acompanhe as eleições de meio de mandato dos Estados Unidos em 2026: Câmara, Senado, governadores e destaques da Flórida.";
const canonical = `${SITE_URL}/eleicoes-eua-2026.html`;
const apiBase = import.meta.env.PUBLIC_US_ELECTIONS_API_BASE_URL || "https://familiausa1-us-elections-api.vercel.app";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <section class="us-election-hero">
    <div class="container us-election-hero-inner">
      <span class="eyebrow hero-eyebrow">Eleições EUA 2026</span>
      <h1>Midterms: acompanhe Câmara, Senado e governadores</h1>
      <p>
        Uma página em português para acompanhar os principais resultados das eleições americanas de 3 de novembro de 2026,
        com destaque especial para a Flórida.
      </p>
      <div class="us-election-meta">
        <span>Election Day: 3 de novembro de 2026</span>
        <span>Resultados preliminares até a certificação oficial</span>
      </div>
    </div>
  </section>

  <section class="container us-election-section">
    <div class="us-status-card" id="us-election-status" data-api-base={apiBase}>
      <div>
        <span class="status-dot" aria-hidden="true"></span>
        <strong id="us-status-title">Midterms confirmadas para 3 de novembro de 2026</strong>
      </div>
      <p id="us-status-message">A página está preparada para acompanhar os resultados.</p>
      <small id="us-status-updated"></small>
    </div>

    <div class="us-section-header">
      <span class="eyebrow">Controle nacional</span>
      <h2>Câmara e Senado</h2>
      <p>O quadro abaixo será atualizado automaticamente quando a fonte de apuração estiver habilitada e os resultados começarem a ser publicados.</p>
    </div>

    <div class="balance-grid" id="balance-grid">
      <article class="balance-card placeholder-card">
        <span>U.S. House</span>
        <h3>Câmara dos Representantes</h3>
        <p>Aguardando Election Day.</p>
      </article>
      <article class="balance-card placeholder-card">
        <span>U.S. Senate</span>
        <h3>Senado</h3>
        <p>Aguardando Election Day.</p>
      </article>
      <article class="balance-card placeholder-card">
        <span>Governors</span>
        <h3>Governadores</h3>
        <p>Aguardando Election Day.</p>
      </article>
    </div>

    <div class="us-section-header florida-header">
      <span class="eyebrow">Destaque</span>
      <h2>Flórida</h2>
      <p>As principais disputas estaduais e federais da Flórida aparecerão aqui durante a apuração.</p>
    </div>

    <div id="florida-races" class="race-grid">
      <article class="race-card placeholder-card">
        <h3>Resultados da Flórida</h3>
        <p>Aguardando dados eleitorais.</p>
      </article>
    </div>

    <div class="us-election-note">
      <strong>Como interpretar:</strong>
      <span>
        Resultados da noite eleitoral nos Estados Unidos são preliminares. “Liderando” não significa “vencedor”.
        Chamadas de corrida feitas por uma organização de apuração também não substituem a certificação das autoridades eleitorais estaduais e locais.
      </span>
    </div>
  </section>

  <script define:vars={{ apiBase }}>
    const statusCard = document.getElementById("us-election-status");
    const statusTitle = document.getElementById("us-status-title");
    const statusMessage = document.getElementById("us-status-message");
    const statusUpdated = document.getElementById("us-status-updated");
    const balanceGrid = document.getElementById("balance-grid");
    const floridaRaces = document.getElementById("florida-races");

    const safe = (value) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

    const fmt = (value) => Number(value || 0).toLocaleString("pt-BR");

    function partyLabel(value) {
      const key = String(value || "").toLowerCase();
      if (key === "dem") return "Democratas";
      if (key === "gop" || key === "rep") return "Republicanos";
      if (key === "others") return "Outros";
      return value || "Outros";
    }

    function renderBalanceCard(report, fallbackTitle) {
      if (!report) {
        return `
          <article class="balance-card placeholder-card">
            <span>${safe(fallbackTitle)}</span>
            <h3>Aguardando resultados</h3>
            <p>Os números aparecerão quando a apuração começar.</p>
          </article>
        `;
      }

      return `
        <article class="balance-card">
          <span>${safe(report.officeCode)}</span>
          <h3>${safe(report.officeName || fallbackTitle)}</h3>
          <div class="party-list">
            ${(report.parties || []).map((party) => `
              <div class="party-row">
                <div>
                  <strong>${safe(partyLabel(party.party))}</strong>
                  <small>Venceram ${fmt(party.won)} · Lideram ${fmt(party.leading)}</small>
                </div>
                <strong class="party-total">${fmt(party.winningTrend)}</strong>
              </div>
            `).join("")}
          </div>
        </article>
      `;
    }

    function renderRace(race) {
      return `
        <article class="race-card">
          <header>
            <div>
              <span class="race-label">${safe(race.statePostal || "FL")}</span>
              <h3>${safe(race.officeName || race.description || "Disputa")}</h3>
            </div>
            ${race.eevp ? `<span class="counting-badge">${safe(race.eevp)}% estimado</span>` : ""}
          </header>
          <div class="candidate-list">
            ${(race.candidates || []).map((candidate) => `
              <div class="candidate-row">
                <div>
                  <strong>${safe(candidate.name)}</strong>
                  <span>${safe(candidate.party || "")}</span>
                </div>
                <div class="candidate-score">
                  <strong>${safe(candidate.percentageDisplay || "0,00%")}</strong>
                  <span>${fmt(candidate.votes)} votos</span>
                </div>
              </div>
            `).join("")}
          </div>
        </article>
      `;
    }

    async function fetchJson(url) {
      const response = await fetch(url, { headers: { Accept: "application/json" }, cache: "no-store" });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return response.json();
    }

    async function refresh() {
      if (!apiBase) {
        statusCard.dataset.status = "waiting-provider";
        statusTitle.textContent = "Infraestrutura preparada — fonte de apuração pendente";
        statusMessage.textContent = "O painel já está pronto. Falta apenas conectar a fonte de dados eleitorais antes do Election Day.";
        statusUpdated.textContent = "";
        return;
      }

      const base = apiBase.replace(/\/$/, "");
      try {
        const [summary, florida] = await Promise.all([
          fetchJson(`${base}/api/eleicoes/eua/2026/summary`),
          fetchJson(`${base}/api/eleicoes/eua/2026/florida`)
        ]);

        statusCard.dataset.status = summary.status || "ready";
        statusTitle.textContent = summary.timeline?.title || "Eleições EUA 2026";
        statusMessage.textContent = summary.message || summary.timeline?.message || "";
        statusUpdated.textContent = summary.snapshotAt
          ? `Última consulta: ${new Date(summary.snapshotAt).toLocaleString("pt-BR")}`
          : "";

        balanceGrid.innerHTML = [
          renderBalanceCard(summary.balance?.house, "U.S. House"),
          renderBalanceCard(summary.balance?.senate, "U.S. Senate"),
          renderBalanceCard(summary.balance?.governors, "Governors")
        ].join("");

        floridaRaces.innerHTML = florida.races?.length
          ? florida.races.map(renderRace).join("")
          : `
            <article class="race-card placeholder-card">
              <h3>Resultados da Flórida</h3>
              <p>${safe(florida.message || "Ainda não há resultados para exibir.")}</p>
            </article>
          `;

        const polling = summary.timeline?.shouldPoll;
        window.setTimeout(refresh, polling ? 15000 : 300000);
      } catch {
        statusCard.dataset.status = "temporarily-unavailable";
        statusTitle.textContent = "Consulta temporariamente indisponível";
        statusMessage.textContent = "Tentaremos novamente automaticamente.";
        window.setTimeout(refresh, 60000);
      }
    }

    refresh();
  </script>

  <style>
    .us-election-hero {
      padding: clamp(88px, 10vw, 132px) 0 clamp(46px, 7vw, 82px);
      color: #fffaf1;
      background:
        radial-gradient(circle at 84% 24%, rgba(56, 96, 149, .48), transparent 28rem),
        radial-gradient(circle at 72% 78%, rgba(155, 61, 37, .2), transparent 22rem),
        linear-gradient(118deg, #0d1725 0%, #14263d 58%, #233f63 100%);
    }

    .us-election-hero-inner { max-width: 1000px; }

    .us-election-hero h1 {
      max-width: 920px;
      margin: 15px 0 18px;
      color: #fffaf1;
      font-family: var(--font-display);
      font-size: clamp(2.35rem, 6vw, 5rem);
      line-height: .98;
      letter-spacing: -.055em;
      text-shadow: 0 2px 18px rgba(0,0,0,.24);
    }

    .us-election-hero p {
      max-width: 820px;
      margin: 0;
      color: rgba(255,250,241,.84);
      font-size: clamp(1.04rem, 2vw, 1.28rem);
      line-height: 1.65;
    }

    .us-election-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      margin-top: 24px;
      color: #ffe2a8;
      font-size: .92rem;
      font-weight: 800;
    }

    .us-election-section { padding-top: 34px; }

    .us-status-card, .balance-card, .race-card, .us-election-note {
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: rgba(255,255,255,.92);
      box-shadow: var(--shadow-soft);
    }

    .us-status-card { padding: 22px 24px; }

    .us-status-card > div {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .us-status-card p {
      margin: 8px 0 5px;
      color: var(--ink-soft);
    }

    .us-status-card small { color: var(--muted); font-weight: 700; }

    .status-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: #c28a2c;
      box-shadow: 0 0 0 6px rgba(194,138,44,.14);
    }

    .us-status-card[data-status="counting"] .status-dot,
    .us-status-card[data-status="voting"] .status-dot {
      background: #2f5c4f;
      box-shadow: 0 0 0 6px rgba(47,92,79,.14);
    }

    .us-section-header {
      max-width: 760px;
      margin: clamp(42px,7vw,72px) 0 22px;
    }

    .us-section-header h2 {
      margin: 10px 0 8px;
      color: var(--navy);
      font-family: var(--font-display);
      font-size: clamp(2rem,4vw,3.2rem);
      letter-spacing: -.04em;
    }

    .us-section-header p { color: var(--ink-soft); }

    .balance-grid, .race-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 18px;
    }

    .balance-card, .race-card { padding: 24px; }

    .balance-card > span, .race-label {
      color: var(--terracotta);
      font-size: .78rem;
      font-weight: 950;
      letter-spacing: .11em;
      text-transform: uppercase;
    }

    .balance-card h3, .race-card h3 {
      margin: 9px 0 16px;
      color: var(--navy);
      font-family: var(--font-display);
      font-size: 1.5rem;
    }

    .placeholder-card { background: rgba(255,255,255,.72); }
    .placeholder-card p { color: var(--muted); }

    .party-list, .candidate-list { display: grid; gap: 9px; }

    .party-row, .candidate-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      border-top: 1px solid rgba(30,26,20,.09);
      padding-top: 11px;
    }

    .party-row div, .candidate-row > div { display: grid; gap: 3px; }

    .party-row small, .candidate-row span {
      color: var(--muted);
      font-size: .82rem;
    }

    .party-total { color: var(--navy); font-size: 1.55rem; }

    .race-card header {
      display: flex;
      justify-content: space-between;
      gap: 16px;
    }

    .counting-badge {
      align-self: flex-start;
      border-radius: 999px;
      padding: 8px 10px;
      color: #225146;
      background: #edf6f1;
      font-size: .8rem;
      font-weight: 900;
    }

    .candidate-score { text-align: right; }
    .candidate-score strong { color: var(--navy); font-size: 1.12rem; }

    .us-election-note {
      display: flex;
      gap: 10px;
      margin-top: 28px;
      padding: 20px;
      color: var(--ink-soft);
      background: var(--surface-warm);
    }

    @media (max-width: 900px) {
      .balance-grid { grid-template-columns: 1fr; }
      .race-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    }

    @media (max-width: 640px) {
      .race-grid { grid-template-columns: 1fr; }
      .race-card header, .party-row, .candidate-row, .us-election-note {
        align-items: flex-start;
        flex-direction: column;
      }
      .candidate-score { text-align: left; }
    }
  </style>
</BaseLayout>
