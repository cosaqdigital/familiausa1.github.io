---
const apiBase = import.meta.env.PUBLIC_ELECTIONS_API_BASE_URL || "https://familiausa1-elections-api.vercel.app";
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Apuração Brasil 2026 - OBS | FamiliaUSA1</title>
    <style>
      :root{
        --navy:#0d1725;
        --ink:#111827;
        --muted:#667085;
        --surface:#f7f2e8;
        --card:#ffffff;
        --line:#ded8cc;
        --green:#2f5c4f;
        --gold:#c28a2c;
      }
      *{box-sizing:border-box}
      html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--surface);font-family:Arial,Helvetica,sans-serif;color:var(--ink)}
      body{padding:24px}
      .shell{height:100%;display:grid;grid-template-rows:auto auto 1fr;gap:18px}
      .brandbar{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:10px 4px}
      .brand{font-weight:900;font-size:20px;color:var(--navy)}
      .source{font-size:14px;font-weight:800;color:var(--muted)}
      .status{border:1px solid var(--line);border-radius:20px;background:var(--card);padding:18px 22px;box-shadow:0 8px 24px rgba(13,23,37,.08)}
      .status-top{display:flex;align-items:center;gap:12px}
      .dot{width:12px;height:12px;border-radius:999px;background:var(--green);box-shadow:0 0 0 6px rgba(47,92,79,.12)}
      #status-title{font-size:23px}
      #status-message{margin:6px 0 0;color:var(--muted);font-size:15px}
      #status-updated{display:block;margin-top:5px;color:var(--muted);font-size:13px;font-weight:700}
      .race{min-height:0;border:1px solid var(--line);border-radius:24px;background:var(--card);padding:22px;display:grid;grid-template-rows:auto 1fr;box-shadow:0 10px 30px rgba(13,23,37,.08)}
      .race-head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:18px}
      .kicker{display:block;color:var(--muted);text-transform:uppercase;letter-spacing:.09em;font-weight:900;font-size:12px}
      h1{margin:5px 0 0;font-size:32px;line-height:1;color:var(--navy)}
      #counted{font-size:18px;font-weight:900;color:var(--green);white-space:nowrap}
      .candidates{min-height:0;display:grid;grid-template-columns:1fr 1fr;gap:18px}
      .candidate{min-width:0;border:2px solid #ece6dc;border-radius:22px;background:#fffdf8;padding:26px;display:flex;flex-direction:column;justify-content:center}
      .candidate-name{font-weight:950;font-size:30px;line-height:1.05;text-transform:uppercase;color:var(--navy)}
      .candidate-party{margin-top:8px;font-size:17px;font-weight:800;color:var(--muted)}
      .candidate-percent{margin-top:28px;font-size:70px;line-height:.95;font-weight:950;letter-spacing:-.04em;color:var(--navy)}
      .candidate-votes{margin-top:12px;font-size:20px;font-weight:800;color:var(--muted)}
      .waiting{display:grid;place-items:center;height:100%;text-align:center;color:var(--muted);font-size:20px;font-weight:800}
      @media(max-width:900px){
        body{padding:14px}
        .candidates{grid-template-columns:1fr}
        .candidate{padding:20px}
        .candidate-percent{font-size:54px}
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <div class="brandbar">
        <div class="brand">FamiliaUSA1 · Eleições Brasil 2026</div>
        <div class="source">Resultados oficiais: TSE</div>
      </div>

      <section class="status" id="status-card">
        <div class="status-top">
          <span class="dot"></span>
          <strong id="status-title">Conectando à apuração oficial...</strong>
        </div>
        <p id="status-message">Buscando dados oficiais do TSE.</p>
        <small id="status-updated"></small>
      </section>

      <section class="race">
        <div class="race-head">
          <div>
            <span class="kicker">Brasil · 2º turno</span>
            <h1>Presidente da República</h1>
          </div>
          <div id="counted">0,00% apurado</div>
        </div>
        <div class="candidates" id="candidates">
          <div class="waiting">Aguardando os primeiros resultados oficiais.</div>
        </div>
      </section>
    </div>

    <script define:vars={{ apiBase }}>
      const endpoint = `${apiBase.replace(/\/$/, "")}/api/eleicoes/2026/segundo-turno`;
      const titleEl = document.getElementById("status-title");
      const messageEl = document.getElementById("status-message");
      const updatedEl = document.getElementById("status-updated");
      const countedEl = document.getElementById("counted");
      const candidatesEl = document.getElementById("candidates");

      const number = (value) => Number.isFinite(Number(value)) ? Number(value) : 0;
      const escapeHtml = (value) => String(value ?? "")
        .replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;")
        .replaceAll('"',"&quot;").replaceAll("'","&#039;");

      function findPresidentGroup(payload){
        const groups=[];
        function walk(value){
          if(!value || typeof value!=="object") return;
          if(Array.isArray(value)){ value.forEach(walk); return; }
          if(Array.isArray(value.candidates) && value.candidates.length){
            groups.push(value);
          }
          Object.values(value).forEach(walk);
        }
        walk(payload);
        return groups.find(g => g.officeCode==="0001" || String(g.officeName||"").toLowerCase().includes("presidente")) || groups[0];
      }

      function pct(value){
        return `${number(value).toFixed(2).replace(".",",")}%`;
      }

      function render(payload){
        const timeline=payload?.timeline||{};
        const status=payload?.status||"ready";
        titleEl.textContent =
          status==="counting" ? "Apuração oficial em andamento" :
          status==="finalized" ? "Apuração oficial finalizada" :
          status==="voting" ? "Votação em andamento" :
          timeline.title || "Aguardando atualização oficial";
        messageEl.textContent = payload?.message || timeline.message || "Aguardando dados oficiais do TSE.";
        updatedEl.textContent = payload?.snapshotAt ? `Última consulta: ${new Date(payload.snapshotAt).toLocaleString("pt-BR")}` : "";

        const group=findPresidentGroup(payload);
        if(!group){
          countedEl.textContent="0,00% apurado";
          candidatesEl.innerHTML='<div class="waiting">Aguardando os primeiros resultados oficiais.</div>';
          return timeline.shouldPoll ?? true;
        }

        const countedValue = Number(group.sections?.percentage);
        countedEl.textContent = Number.isFinite(countedValue)
          ? `${countedValue.toFixed(2).replace(".",",")}% apurado`
          : (group.sections?.percentageDisplay ? `${group.sections.percentageDisplay} apurado` : "Apuração em andamento");

        const candidates=[...group.candidates].sort((a,b)=>number(b.votes)-number(a.votes)).slice(0,2);
        candidatesEl.innerHTML=candidates.map(candidate=>`
          <article class="candidate">
            <div class="candidate-name">${escapeHtml(candidate.ballotName || candidate.name)}</div>
            <div class="candidate-party">${escapeHtml(candidate.party || "")}${candidate.number ? ` · ${escapeHtml(candidate.number)}` : ""}</div>
            <div class="candidate-percent">${pct(candidate.percentage)}</div>
            <div class="candidate-votes">${number(candidate.votes).toLocaleString("pt-BR")} votos</div>
          </article>
        `).join("");

        return timeline.shouldPoll ?? ["voting","waiting-results","counting"].includes(status);
      }

      async function refresh(){
        try{
          const response=await fetch(endpoint,{headers:{Accept:"application/json"},cache:"no-store"});
          if(!response.ok) throw new Error(`HTTP ${response.status}`);
          const payload=await response.json();
          const shouldPoll=render(payload);
          setTimeout(refresh, shouldPoll ? 15000 : 60000);
        }catch{
          titleEl.textContent="Consulta temporariamente indisponível";
          messageEl.textContent="Tentando reconectar automaticamente à fonte oficial.";
          setTimeout(refresh,30000);
        }
      }
      refresh();
    </script>
  </body>
</html>
