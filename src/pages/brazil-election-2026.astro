---
import EnglishElectionLayout from "../layouts/EnglishElectionLayout.astro";
import { SITE_URL } from "../data/pilotContent";

const title = "Brazil Election 2026 Live Results: Presidential Runoff | FamiliaUSA1";
const description = "Follow Brazil's 2026 presidential runoff live with official TSE vote totals, percentages, counting progress and automatic updates in English.";
const canonical = `${SITE_URL}/brazil-election-2026.html`;
const portugueseUrl = `${SITE_URL}/eleicoes-brasil-2026.html`;
const apiBase = import.meta.env.PUBLIC_ELECTIONS_API_BASE_URL || "https://familiausa1-elections-api.vercel.app";
const alternates = [
  { hreflang: "en-US", href: canonical },
  { hreflang: "pt-BR", href: portugueseUrl },
  { hreflang: "x-default", href: portugueseUrl }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Brazil Election 2026 Live Results",
  description,
  url: canonical,
  inLanguage: "en-US",
  isPartOf: {
    "@type": "WebSite",
    name: "FamiliaUSA1",
    url: SITE_URL
  },
  about: {
    "@type": "Thing",
    name: "2026 Brazilian presidential election runoff"
  }
};
---

<EnglishElectionLayout
  title={title}
  description={description}
  canonical={canonical}
  schemas={[schema]}
  alternates={alternates}
>
  <section class="brazil-hero">
    <div class="container hero-inner">
      <div class="hero-kicker">BRAZIL PRESIDENTIAL ELECTION 2026</div>
      <h1>Live Presidential Runoff Results</h1>
      <p class="hero-lede">
        Follow Brazil's October 25 presidential runoff with official vote data from the
        Superior Electoral Court (TSE). This page updates automatically as results are released.
      </p>
      <div class="hero-meta">
        <span>Runoff: October 25, 2026</span>
        <span>Official data source: TSE</span>
        <span id="local-close-time">Polls close at 5:00 PM Brasília time</span>
      </div>
      <div class="hero-actions">
        <a class="button primary" href="#live-results">View live results</a>
        <a class="language-link" href="/eleicoes-brasil-2026.html" lang="pt-BR">Ver em português →</a>
      </div>
    </div>
  </section>

  <section class="container election-section" id="live-results">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Official count</span>
        <h2>Brazil runoff live results</h2>
      </div>
      <p>Vote totals and percentages below come from the same TSE-backed data service used by our Portuguese results page.</p>
    </div>

    <div class="election-status-card" id="election-status" data-api-base={apiBase}>
      <div class="status-line">
        <span class="status-dot" aria-hidden="true"></span>
        <strong id="status-title">Connecting to the official count...</strong>
      </div>
      <p id="status-message">Checking the current election status.</p>
      <small id="status-updated"></small>
    </div>

    <div id="election-results" class="election-results" aria-live="polite"></div>

    <div class="source-note">
      <strong>Source note</strong>
      <p>
        FamiliaUSA1 does not count votes or project a winner. We display election data obtained through
        our service built to read official TSE results. If any discrepancy appears, the TSE publication controls.
      </p>
    </div>
  </section>

  <section class="context-band" id="first-round">
    <div class="container context-grid">
      <div class="context-copy">
        <span class="eyebrow">First-round context</span>
        <h2>How the runoff was reached</h2>
        <p>
          Brazil's Superior Electoral Court reported that Flávio Bolsonaro (PL) and Luiz Inácio Lula da Silva (PT)
          advanced to the presidential runoff after the October 4 first round.
        </p>
        <p>
          The official first-round shares of valid votes were 47.03% for Flávio Bolsonaro and 45.16% for Lula.
          Those percentages are historical context only and do not carry over into the runoff count.
        </p>
      </div>
      <div class="first-round-card" aria-label="Official first-round presidential results">
        <div class="round-row">
          <div><strong>Flávio Bolsonaro</strong><span>PL</span></div>
          <strong class="round-score">47.03%</strong>
        </div>
        <div class="round-bar"><span style="width:47.03%"></span></div>
        <div class="round-row">
          <div><strong>Luiz Inácio Lula da Silva</strong><span>PT</span></div>
          <strong class="round-score">45.16%</strong>
        </div>
        <div class="round-bar"><span style="width:45.16%"></span></div>
        <small>Official first-round share of valid votes · TSE</small>
      </div>
    </div>
  </section>

  <section class="container explainer-section" id="how-it-works">
    <div class="section-heading">
      <div>
        <span class="eyebrow">For international readers</span>
        <h2>How Brazil reports election results</h2>
      </div>
    </div>

    <div class="explainer-grid">
      <article>
        <span class="step">01</span>
        <h3>A national election authority</h3>
        <p>Brazil's Superior Electoral Court (TSE) is the national authority responsible for publishing the official election count.</p>
      </article>
      <article>
        <span class="step">02</span>
        <h3>Results update progressively</h3>
        <p>After voting closes, official totals change as polling-station data is received and processed. An early lead is not a final result.</p>
      </article>
      <article>
        <span class="step">03</span>
        <h3>This page refreshes automatically</h3>
        <p>During active counting, the browser checks our election API frequently so visitors can keep the page open without manually refreshing it.</p>
      </article>
    </div>

    <div class="timezone-card">
      <div>
        <span class="eyebrow">Your local time</span>
        <h2>When will results begin?</h2>
      </div>
      <div>
        <p>Brazil's second-round voting is scheduled to close at 5:00 PM Brasília time.</p>
        <strong id="viewer-close-time">Calculating the equivalent time in your time zone...</strong>
        <small id="viewer-timezone"></small>
      </div>
    </div>

    <div class="official-links">
      <p>
        Want the original Brazilian source? Visit the
        <a href="https://www.tse.jus.br/" rel="noopener noreferrer">Superior Electoral Court (TSE)</a>.
        Brazilian readers can use the
        <a href="/eleicoes-brasil-2026.html" lang="pt-BR">Portuguese version of this live page</a>.
      </p>
    </div>
  </section>

  <script define:vars={{ apiBase }}>
    const endpoint = `${apiBase.replace(/\/$/, "")}/api/eleicoes/2026/segundo-turno`;
    const statusCard = document.getElementById("election-status");
    const statusTitle = document.getElementById("status-title");
    const statusMessage = document.getElementById("status-message");
    const statusUpdated = document.getElementById("status-updated");
    const results = document.getElementById("election-results");
    const viewerCloseTime = document.getElementById("viewer-close-time");
    const viewerTimezone = document.getElementById("viewer-timezone");
    const localCloseTime = document.getElementById("local-close-time");

    const number = (value) => Number.isFinite(Number(value)) ? Number(value) : 0;
    const escapeHtml = (value) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

    const statusCopy = {
      "before-election": {
        title: "Runoff scheduled for October 25, 2026",
        message: "Official runoff results are not available yet."
      },
      "voting": {
        title: "Voting is underway in Brazil",
        message: "Official results will appear after the TSE begins publishing the count."
      },
      "waiting-results": {
        title: "Waiting for the first official results",
        message: "Polls have closed and this page is checking for the first TSE update."
      },
      "counting": {
        title: "Official counting is underway",
        message: "Results are updating as official vote totals are processed."
      },
      "finalized": {
        title: "Official count completed",
        message: "The TSE count reported by this feed has been completed."
      },
      "ready": {
        title: "Election data service is ready",
        message: "The page is prepared and waiting for official runoff results."
      }
    };

    function setLocalElectionTime() {
      const close = new Date("2026-10-25T20:00:00Z");
      try {
        const formatted = new Intl.DateTimeFormat("en-US", {
          weekday: "long",
          month: "long",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit",
          timeZoneName: "short"
        }).format(close);
        const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || "your local time zone";
        viewerCloseTime.textContent = formatted;
        viewerTimezone.textContent = `Detected time zone: ${zone}`;
        localCloseTime.textContent = `In your time zone: ${formatted}`;
      } catch {
        viewerCloseTime.textContent = "5:00 PM Brasília time (BRT)";
        viewerTimezone.textContent = "";
      }
    }

    function candidateGroups(payload) {
      const groups = [];
      const seen = new Set();

      function walk(value) {
        if (!value || typeof value !== "object") return;
        if (Array.isArray(value)) {
          value.forEach(walk);
          return;
        }

        if (Array.isArray(value.candidates) && value.candidates.length) {
          const key = [value.scope, value.officeCode, value.officeName, value.electionId].filter(Boolean).join("|");
          if (!seen.has(key)) {
            seen.add(key);
            groups.push(value);
          }
        }

        Object.values(value).forEach(walk);
      }

      walk(payload);
      return groups;
    }

    function translatedOffice(group) {
      if (group.officeCode === "0001") return "President of Brazil";
      const name = String(group.officeName || "").toLowerCase();
      if (name.includes("presidente")) return "President of Brazil";
      if (name.includes("governador")) return "Governor";
      return group.officeName || "Election result";
    }

    function renderGroup(group) {
      const candidates = [...group.candidates].sort((a, b) => number(b.votes) - number(a.votes));
      const counting = group.sections?.percentageDisplay || "";
      const title = translatedOffice(group);
      const scope = group.scope && group.scope.toLowerCase() !== "br" ? group.scope.toUpperCase() : "Brazil";

      return `
        <article class="election-card">
          <header class="election-card-header">
            <div>
              <span class="election-scope">${escapeHtml(scope)}</span>
              <h2>${escapeHtml(title)}</h2>
            </div>
            ${counting ? `<span class="counting-badge">${escapeHtml(counting)} counted</span>` : ""}
          </header>
          <div class="candidate-list">
            ${candidates.map((candidate) => `
              <div class="candidate-row">
                <div class="candidate-main">
                  <strong>${escapeHtml(candidate.ballotName || candidate.name)}</strong>
                  <span>${escapeHtml(candidate.party || "")}${candidate.number ? ` · Ballot no. ${escapeHtml(candidate.number)}` : ""}</span>
                </div>
                <div class="candidate-score">
                  <strong>${escapeHtml(candidate.percentageDisplay || `${number(candidate.percentage).toFixed(2)}%`)}</strong>
                  <span>${number(candidate.votes).toLocaleString("en-US")} votes</span>
                </div>
              </div>
            `).join("")}
          </div>
        </article>
      `;
    }

    function render(payload) {
      const timeline = payload?.timeline || {};
      const status = payload?.status || "temporarily-unavailable";
      const copy = statusCopy[status] || {
        title: "Waiting for an official update",
        message: "No official runoff result is available to display yet."
      };

      statusCard.dataset.status = status;
      statusTitle.textContent = copy.title;
      statusMessage.textContent = copy.message;
      statusUpdated.textContent = payload?.snapshotAt
        ? `Last checked: ${new Date(payload.snapshotAt).toLocaleString("en-US")}`
        : "";

      const groups = candidateGroups(payload);
      results.innerHTML = groups.length
        ? groups.map(renderGroup).join("")
        : `
          <div class="waiting-card">
            <h2>No runoff results to display yet</h2>
            <p>${escapeHtml(copy.message)}</p>
            <p>This page will continue checking the official results service automatically.</p>
          </div>
        `;

      return timeline.shouldPoll ?? ["voting", "waiting-results", "counting"].includes(status);
    }

    async function refresh() {
      try {
        const response = await fetch(endpoint, {
          headers: { Accept: "application/json" },
          cache: "no-store"
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const payload = await response.json();
        const shouldPoll = render(payload);
        window.setTimeout(refresh, shouldPoll ? 15000 : 60000);
      } catch {
        statusCard.dataset.status = "temporarily-unavailable";
        statusTitle.textContent = "Official data is temporarily unavailable";
        statusMessage.textContent = "We could not reach the election data service. This page will try again automatically.";
        statusUpdated.textContent = "";
        results.innerHTML = `
          <div class="waiting-card">
            <h2>Trying to reconnect</h2>
            <p>The official election record remains under the responsibility of Brazil's Superior Electoral Court (TSE).</p>
          </div>
        `;
        window.setTimeout(refresh, 30000);
      }
    }

    setLocalElectionTime();
    refresh();
  </script>

  <style>
    .brazil-hero {
      padding: clamp(88px, 10vw, 142px) 0 clamp(48px, 7vw, 82px);
      color: #fff;
      background:
        radial-gradient(circle at 84% 24%, rgba(255, 215, 0, .21), transparent 23rem),
        radial-gradient(circle at 74% 76%, rgba(0, 146, 70, .35), transparent 28rem),
        linear-gradient(125deg, #071923 0%, #0b3040 52%, #123f37 100%);
    }
    .hero-inner{max-width:980px}.hero-kicker{color:#f7d768;font-size:.8rem;font-weight:950;letter-spacing:.14em}
    .brazil-hero h1{max-width:900px;margin:14px 0 18px;color:#fff;font-family:var(--font-display);font-size:clamp(2.65rem,6vw,5.25rem);line-height:.97;letter-spacing:-.055em;text-shadow:0 3px 20px rgba(0,0,0,.24)}
    .hero-lede{max-width:800px;margin:0;color:rgba(255,255,255,.84);font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.65}
    .hero-meta{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:24px;color:#f7e8a1;font-size:.9rem;font-weight:800}
    .hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:18px;margin-top:26px}.language-link{color:#fff;font-weight:850;text-decoration:none}.language-link:hover{text-decoration:underline}
    .election-section,.explainer-section{padding-top:42px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:22px}.section-heading>div{max-width:670px}.section-heading>p{max-width:500px;color:var(--ink-soft)}
    .section-heading h2,.context-copy h2,.timezone-card h2{margin:8px 0 0;color:var(--navy);font-family:var(--font-display);font-size:clamp(2rem,4vw,3.4rem);letter-spacing:-.045em}
    .election-status-card,.waiting-card,.election-card,.source-note,.first-round-card,.timezone-card,.explainer-grid article{border:1px solid var(--line);border-radius:var(--radius-lg);background:rgba(255,255,255,.94);box-shadow:var(--shadow-soft)}
    .election-status-card{padding:22px 24px}.status-line{display:flex;align-items:center;gap:10px}.election-status-card p{margin:8px 0 5px;color:var(--ink-soft)}.election-status-card small{color:var(--muted);font-weight:700}
    .status-dot{width:11px;height:11px;border-radius:999px;background:#c28a2c;box-shadow:0 0 0 6px rgba(194,138,44,.14)}
    .election-status-card[data-status="counting"] .status-dot,.election-status-card[data-status="voting"] .status-dot,.election-status-card[data-status="ready"] .status-dot{background:#2f5c4f;box-shadow:0 0 0 6px rgba(47,92,79,.14)}
    .election-results{display:grid;gap:20px;margin-top:22px}.waiting-card,.election-card{padding:clamp(22px,4vw,34px)}.waiting-card h2,.election-card h2{margin:0;color:var(--navy);font-family:var(--font-display)}.waiting-card p{color:var(--ink-soft)}
    .election-card-header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px}.election-scope{color:var(--terracotta);font-size:.78rem;font-weight:950;letter-spacing:.11em;text-transform:uppercase}
    .counting-badge{border-radius:999px;padding:8px 11px;color:#225146;background:#edf6f1;font-size:.82rem;font-weight:900;white-space:nowrap}
    .candidate-list{display:grid;gap:10px}.candidate-row{display:flex;align-items:center;justify-content:space-between;gap:18px;border:1px solid rgba(30,26,20,.1);border-radius:18px;padding:15px 17px;background:#fffdf8}
    .candidate-main,.candidate-score{display:grid;gap:3px}.candidate-main span,.candidate-score span{color:var(--muted);font-size:.86rem;font-weight:700}.candidate-score{text-align:right}.candidate-score strong{color:var(--navy);font-size:1.25rem}
    .source-note{margin-top:22px;padding:18px 20px;background:var(--surface-warm)}.source-note p{margin:5px 0 0;color:var(--ink-soft)}
    .context-band{margin-top:48px;padding:52px 0;background:#f1eee6}.context-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}.context-copy p{color:var(--ink-soft);line-height:1.65}
    .first-round-card{padding:26px}.round-row{display:flex;justify-content:space-between;align-items:center;gap:20px}.round-row>div{display:grid}.round-row span{color:var(--muted);font-size:.86rem;font-weight:800}.round-score{color:var(--navy);font-size:1.35rem}.round-bar{height:10px;margin:9px 0 19px;border-radius:999px;background:#e6e2d9;overflow:hidden}.round-bar span{display:block;height:100%;border-radius:999px;background:#315f6f}.first-round-card small{color:var(--muted)}
    .explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.explainer-grid article{padding:25px}.step{color:var(--terracotta);font-weight:950;letter-spacing:.1em}.explainer-grid h3{margin:9px 0;color:var(--navy)}.explainer-grid p{color:var(--ink-soft);line-height:1.6}
    .timezone-card{display:grid;grid-template-columns:.8fr 1.2fr;gap:28px;margin-top:30px;padding:clamp(24px,4vw,36px);background:linear-gradient(135deg,#fffaf1,#f2eee5)}.timezone-card p{color:var(--ink-soft)}.timezone-card strong{display:block;color:var(--navy);font-size:1.25rem}.timezone-card small{display:block;margin-top:7px;color:var(--muted)}
    .official-links{margin:28px 0 10px;color:var(--ink-soft)}.official-links a{font-weight:850}
    @media(max-width:760px){.section-heading,.election-card-header,.candidate-row{align-items:flex-start;flex-direction:column}.candidate-score{text-align:left}.context-grid,.explainer-grid,.timezone-card{grid-template-columns:1fr}.counting-badge{white-space:normal}}
  </style>
</EnglishElectionLayout>
